# =============================================================================
# FibrePulse environment variables
# Copy to .env.local for development. Never commit real values.
# Variables starting with NEXT_PUBLIC_ are sent to the browser: never put a
# secret in one.
# =============================================================================

# --- Supabase (required) ------------------------------------------------------
# Local values are printed by `npx supabase status` after `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by the connector ingest endpoint and payment callbacks
# (Phase 4 and the M-Pesa integration). Not used by any Phase 1 code path.
SUPABASE_SECRET_KEY=

# --- Site ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Router credential encryption (Phase 4) ----------------------------------
# 32-byte key, base64. Generate with: openssl rand -base64 32
ROUTER_CREDENTIALS_KEY=

# --- Safaricom Daraja / M-Pesa ------------------------------------------------
# TODO: SOFTWARE ENGINEER - IMPLEMENT SAFARICOM DARAJA INTEGRATION.
# See docs/MPESA_INTEGRATION_HANDOVER.md. Leave empty until then.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=

# --- Tests ---------------------------------------------------------------------
# Database tests connect directly to the local Supabase Postgres.
TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
