# FibrePulse Connector Agent settings. Copy to .env (or set in the service unit).
# The token is shown once when you register the connector in FibrePulse
# (Network Monitoring > Connectors). Treat it like a password.
FIBREPULSE_URL=https://app.fibrepulse.example
FIBREPULSE_TOKEN=

# How often to read routers (seconds). FibrePulse can lower or raise this.
POLL_INTERVAL_SECONDS=60
# How often to check for configuration changes and commands (seconds).
SYNC_INTERVAL_SECONDS=15
# Per-request timeout to routers and to FibrePulse (seconds).
REQUEST_TIMEOUT_SECONDS=10

# Router writes are OFF by default. Set to true only when the ISP owner has
# turned on "Disconnect suspended customers on the router" in FibrePulse and the
# router API user has the write policy. Only PPPoE disable/enable is ever done.
ALLOW_ROUTER_WRITES=false

# Optional: keep router passwords on this machine only, instead of in
# FibrePulse. JSON file: { "<router id>": { "username": "...", "password": "..." } }
ROUTER_CREDENTIALS_FILE=

# Development only: report SIMULATED readings for routers marked simulated.
SIMULATE=false

# RADIUS (only when the ISP sets "Access control: RADIUS" in FibrePulse).
# The connector serves FibrePulse's "who may connect, at what speed" list to the
# ISP's FreeRADIUS server (rlm_rest). Passwords stay in the ISP's RADIUS.
# 0 turns the endpoint off. Bind to a LAN address FreeRADIUS can reach.
RADIUS_POLICY_PORT=0
RADIUS_POLICY_HOST=127.0.0.1
# At least 24 characters; FreeRADIUS sends it in X-FibrePulse-Radius-Secret.
RADIUS_POLICY_SECRET=
# Keeps the last list on disk so customers can still connect if the internet
# link to FibrePulse is down. Recommended: /var/lib/fibrepulse/radius.json
RADIUS_CACHE_FILE=
